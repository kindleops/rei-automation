{
  // PRODUCTION Cloudflare configuration -- DISTINCT from staging.
  //
  // Deliberately a separate Worker, separate container application and separate
  // Durable Object namespace. Staging shares the production DATABASE for
  // commissioning, which is precisely why the two deployments must not share a
  // Worker: production must be independently controllable.
  //
  // Uses the SAME proven image as staging (registry reference, so no Docker is
  // needed at deploy time).
  //
  // POSTURE -- OUTBOUND COMMISSIONED (operator authorization).
  // This file previously described a deliberately inert deployment. That is no
  // longer true and the comment is updated rather than left to mislead:
  //   * triggers.crons declares TWO expressions: the send-incapable */5
  //     reconciliation lane, and a one-minute lane carrying the queue runner.
  //   * CRON_ENABLED=true, and CRON_QUEUE_RUN_ENABLED=true names the one
  //     send-capable job explicitly. Both are required; neither alone suffices.
  //   * A custom domain IS live (ops.leadcommand.ai).
  // What has NOT changed: every runtime rail. The operator brakes in
  // system_control still gate each individual row, and they outrank this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lead-command-production",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "../../apps/dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "registry.cloudflare.com/ACCOUNT_ID_PLACEHOLDER/rei-api:TAG_PLACEHOLDER",
      "instance_type": "standard",
      // Single instance. Raising this is gated on the scale-out checklist in
      // docs/cloudflare/topology-contract.md.
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "API_CONTAINER", "class_name": "ApiContainer" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }],

  // THE ONLY PRODUCTION SCHEDULE. Maps -- via the environment-scoped table in
  // worker/index.ts -- to exactly one job: delivery-outcome reconciliation,
  // which is structurally incapable of producing a sendable queue row.
  //
  // Every send-capable job (queue/run, queue retry, queue force-due, campaign
  // feed, campaign activation, stale-expired recovery, autopilot, the inbound
  // burst/recovery follow-up legs) is absent from PRODUCTION_CRON_JOBS, so no
  // trigger can reach one. This expression fires that single reconciler only.
  //
  // Two independent guards still stand in front of it: CRON_ENABLED must be
  // "true", and CRON_SECRET must be present. Both are deliberate commissioning
  // acts, not code changes.
  "triggers": {
    // */5 = reconciliation lane (send-incapable, unchanged).
    // *   = production send lane. One minute is the finest cadence Cloudflare
    //       offers and it is what makes a row's scheduled_for operationally
    //       meaningful: a row due at 13:00 goes out at 13:00, not up to five
    //       minutes later.
    "crons": ["*/5 * * * *", "* * * * *"]
  },

  "vars": {
    // COMMISSIONED. The master switch is necessary but not sufficient: each job
    // in worker/index.ts names its own flag, so turning this on cannot awaken a
    // job that was not separately approved below.
    // Canonical origin for privileged internal server-to-server calls.
    // Deliberately distinct from APP_BASE_URL, which has mixed semantics and
    // previously routed these credential-bearing calls to a stale deployment.
    "INTERNAL_API_BASE_URL": "https://ops.leadcommand.ai",

    // The exact public origin TextGrid POSTs delivery callbacks to. This is the
    // signature material, so it must match the provider-side configuration
    // exactly. Kept distinct from APP_BASE_URL on purpose.
    "TEXTGRID_WEBHOOK_PUBLIC_BASE_URL": "https://ops.leadcommand.ai",

    "CRON_ENABLED": "true",
    // Per-job authority. These two remain RECONCILIATION lanes and remain
    // send-incapable. Campaign feed, campaign activation, autopilot, queue
    // retry, force-due and DocuSign are STILL not registered for any
    // environment -- commissioning the runner did not commission them.
    "CRON_SELLER_STATE_RECONCILE_ENABLED": "true",
    "CRON_DELIVERY_RECONCILE_ENABLED": "true",
    // PRODUCTION OUTBOUND COMMISSIONED. Per-job authority for the one
    // send-capable job. This flag only permits the runner to be invoked; the
    // operator brakes in system_control (queue_execution_mode,
    // queue_processor_mode, queue_emergency_stop_at) still decide whether any
    // individual row is allowed to leave, and they outrank this.
    "CRON_QUEUE_RUN_ENABLED": "true",
    "DEPLOYMENT_ENV": "production",
    "DEPLOYMENT_PROVIDER": "cloudflare",
    "DEPLOY_GIT_SHA": "GIT_SHA_PLACEHOLDER",
    "DEPLOYMENT_ID": "DEPLOYMENT_ID_PLACEHOLDER"
  },

  "observability": { "enabled": true }
}
