ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER_TOKEN=
ALERT_SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_MIN_SEVERITY_WEBHOOK=high
ALERT_MIN_SEVERITY_SLACK=high
ALERT_MIN_SEVERITY_EMAIL=critical
ALERT_DELIVERY_COOLDOWN_MINUTES=60
ALERT_RENOTIFY_EVERY_OCCURRENCES=10
ALERT_EMAIL_SUBJECT_PREFIX=[REA Alert]
ALERT_HTTP_TIMEOUT_MS=15000

TITLE_WEBHOOK_SECRET=
CLOSINGS_WEBHOOK_SECRET=

STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=
STORAGE_SIGNING_SECRET=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false

ENABLE_DEALS_AUTOPILOT=true
ENABLE_LIVE_SENDING=false
AUTOMATION_LIVE_SENDS_ENABLED=false
WORKFLOW_LIVE_SENDS_ENABLED=false
ENABLE_AI_ASSIST=true
ENABLE_AUTO_OFFER_FLOW=true
ENABLE_AUTO_CONTRACT_FLOW=true
ENABLE_AUTO_CONTRACT_SEND=false
ENABLE_AUTO_TITLE_ROUTING=true
ENABLE_AUTO_TITLE_COMPANY_ASSIGNMENT=true
ENABLE_AUTO_TITLE_INTRO=true
ENABLE_AUTO_CLOSING_FLOW=true
ENABLE_AUTO_BUYER_MATCH=false
ENABLE_AUTO_BUYER_BLAST=false
ENABLE_BUYER_SMS_BLAST=false
ENABLE_AUTO_REVENUE_SYNC=true
DEALS_AUTOPILOT_SCAN_LIMIT=25

ROLLOUT_FEEDER_MAX_BATCH=25
ROLLOUT_QUEUE_MAX_BATCH=50
ROLLOUT_RETRY_MAX_BATCH=50
ROLLOUT_RECONCILE_MAX_BATCH=50
ROLLOUT_AUTOPILOT_MAX_SCAN=25
ROLLOUT_BUYER_BLAST_MAX_RECIPIENTS=5
ROLLOUT_FEEDER_VIEW_ONLY_ID=
ROLLOUT_FEEDER_VIEW_ONLY_NAME=
ROLLOUT_SINGLE_MASTER_OWNER_ID=
ROLLOUT_SINGLE_CONTRACT_ID=
ROLLOUT_SINGLE_BUYER_MATCH_ID=

# ── Email (Brevo) ────────────────────────────────────────────────────────────
# Server-only. None of these may ever be exposed to a browser bundle.
#
# Credentials are resolved PER BRAND: a caller that names a brand gets that
# brand's key or nothing. BREVO_API_KEY is the legacy fallback and is used only
# for an unbranded call, so a branded send can never go out under the wrong
# identity because a shared key happened to be set.
BREVO_PROMINENT_API_KEY=
BREVO_REIVESTI_API_KEY=
BREVO_API_KEY=

# REQUIRED before the webhook will accept anything. With this unset the endpoint
# refuses every request with 503 rather than accepting unauthenticated events;
# an unset secret used to mean "accept everything", which let anyone who found
# the URL mark a seller unsubscribed.
BREVO_WEBHOOK_SECRET=

# Which brand's credential an unbranded send should use.
EMAIL_DEFAULT_BRAND_KEY=prominent_cash_offer

# Fallback sender identity. Prefer rows in public.email_senders: those carry
# caps, warm-up state and a status, and these do not. The dispatch path REFUSES
# rather than falling back to these, deliberately.
EMAIL_DEFAULT_SENDER_EMAIL=
EMAIL_DEFAULT_SENDER_NAME=Acquisitions Team
EMAIL_DEFAULT_REPLY_TO=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Legacy manual-send guard. The canonical kill switch is the system_control row
# `email_enabled`, which is what the dispatch path reads.
EMAIL_SEND_ENABLED=false

# Comma-separated addresses that internal test sends may target.
EMAIL_TEST_ALLOWLIST=

# ── Inbound replies (EMAIL-3) ────────────────────────────────────────────────
# The domain seller replies are addressed to, e.g. reply.example.com. Setting it
# is NOT enough to start advertising it: the system_control flag
# `email_reply_aliases_enabled` must also be on, and that flag is an operator's
# attestation that the MX records are live and the inbound consumer is deployed.
#
# Advertising a Reply-To on a domain with no MX is the worst failure in this
# phase: the seller believes they answered, the operator sees silence, and
# nothing logs an error. With either control off, sends fall back to the
# sender's own reply mailbox and say so in the dispatch result.
EMAIL_REPLY_DOMAIN=

# Brevo publishes NO signature for inbound parse webhooks -- not an HMAC, not a
# shared key. The controls below are what the provider genuinely supports.
#
# The capability token is embedded in the webhook PATH, so possession of the URL
# is the credential. Generate with: openssl rand -hex 32. It is a bearer secret
# in a URL, so it can leak through logs and proxies in a way an HMAC cannot --
# rotate it if the endpoint URL is ever exposed. With this and the header secret
# both unset, the endpoint refuses every request rather than accepting
# unauthenticated mail.
BREVO_INBOUND_URL_TOKEN=

# Optional second credential for a proxy that can add a shared-secret header.
# Falls back to BREVO_WEBHOOK_SECRET when unset, so both surfaces agree on what
# "authenticated" means.
BREVO_INBOUND_WEBHOOK_SECRET=

# ── Brevo 429 rate-limit probe (scripts/proof/brevo-429-probe.mjs) ───────────
# Only set when deliberately running the probe. It sends real API traffic.
BREVO_PROBE_CONFIRM=
BREVO_PROBE_RECIPIENT=
BREVO_PROBE_SENDER=
BREVO_PROBE_BRAND=
BREVO_PROBE_BURST=40
