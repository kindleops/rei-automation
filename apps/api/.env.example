ROLLOUT_MODE=beta
CRON_SECRET=
INTERNAL_API_SECRET=
OPS_DASHBOARD_SECRET=
BUYER_WEBHOOK_SECRET=

OPENAI_KEY=
OPENCODE_ZEN_API_KEY=
APP_BASE_URL=

PODIO_CLIENT_ID=
PODIO_CLIENT_SECRET=
PODIO_USERNAME=
PODIO_PASSWORD=
PODIO_APP_TOKEN=

TEXTGRID_ACCOUNT_SID=
TEXTGRID_AUTH_TOKEN=
TEXTGRID_WEBHOOK_SECRET=
TEXTGRID_API_BASE_URL=

DOCUSIGN_API_KEY=
DOCUSIGN_WEBHOOK_SECRET=
DOCUSIGN_BASE_URL=
DOCUSIGN_DEFAULT_TEMPLATE_ID=
DOCUSIGN_SELLER_ROLE_NAME=Seller
DOCUSIGN_BUYER_NAME=
DOCUSIGN_BUYER_EMAIL=
DOCUSIGN_BUYER_ROLE_NAME=Buyer

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
